generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  REGULAR
  PREMIUM
}
enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id        String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  public_id      String   @unique
  name      String
  email     String
  password  String?    @db.VarChar(255)

  user_type    UserType   @default(REGULAR)
  image_url String?
  created_at DateTime @default(now())

  accounts  Account[]
  transactions  Transaction[]
  initialSalary  InitialSalary[]

  @@map("users")
}

model Account {
  id        String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  balance   BigInt   @default(0)

  user_id    String   @db.Uuid
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)


  created_at DateTime @default(now())

  @@index([user_id])
  @@map("accounts")
}


model Transaction {
  ref_id          String   @db.Uuid     

  id              String    @unique
  name_transaction      String      @db.VarChar(255)
  information   String?     @db.VarChar(255)
  nominal       Int
  created_at DateTime @default(now())
  updated_at DateTime? @updatedAt


  user      User     @relation(fields: [ref_id], references: [id], onDelete: Cascade)

  transactionImage  TransactionImages[]
  initialSalary  InitialSalary?
  
  @@map("transactions")
}


model TransactionImages {
  ref_id    String
  id          String      @unique
  image_id        String
  image_name      String
  image_url       String

  transaction     Transaction   @relation(fields: [ref_id], references: [id], onDelete: Cascade)


  @@map("transaction_images")
}


model InitialSalary {
  ref_id_user          String   @db.Uuid     
  ref_id_transaction   String   @unique
  salary_income        Int
  salary_remaining     Int?
  created_at DateTime @default(now())
  updated_at DateTime? @updatedAt

  user      User     @relation(fields: [ref_id_user], references: [id], onDelete: Cascade)
  transaction      Transaction     @relation(fields: [ref_id_transaction], references: [id], onDelete: Cascade)

  @@map("initial_salary")
}