generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  REGULAR
  PREMIUM
}

enum IdStatus {
  ACTIVE
  DEFAULT
  FINISH
}

enum TransactionStatus {
  AVAILABLE
  DELETED
}

model User {
  id        String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  public_id      String   @unique
  name      String
  email     String
  password  String?    @db.VarChar(255)

  user_type    UserType?  @default(REGULAR)
  image_url String?
  created_at DateTime @default(now())

  transactions  Transaction[]
  initialSalary  InitialSalary[]

  @@map("users")
}

model InitialSalary {
  ref_id_user          String   @db.Uuid     
  id   String          @id
  initial_name    String   @db.VarChar(255)
  salary_income        Int
  salary_remaining     Int?
  created_at DateTime @default(now())
  updated_at DateTime? @updatedAt
  status      IdStatus     @default(ACTIVE)

  user      User     @relation(fields: [ref_id_user], references: [id], onDelete: Cascade)
  transaction  Transaction[]

  @@index([ref_id_user])
  @@index([initial_name])
  @@index([status])
  @@index([created_at])
  @@map("initial_salary")
}

model Transaction {
  id   String  @id
  ref_id_user         String   @db.Uuid     
  ref_id              String   
  name_transaction      String      @db.VarChar(255)
  information   String?     @db.VarChar(255)
  nominal       Int
  created_at DateTime @default(now())
  updated_at DateTime? @updatedAt
  status      TransactionStatus     @default(AVAILABLE)

  user      User     @relation(fields: [ref_id_user], references: [id], onDelete: Cascade)
  initialSalary      InitialSalary     @relation(fields: [ref_id], references: [id], onDelete: Cascade)

  transactionImage  TransactionImages[]
  
  @@map("transactions")

  @@index([created_at, ref_id_user, updated_at])
  @@index([created_at, ref_id_user])
  @@index([created_at])
}


model TransactionImages {
  ref_id      String
  id          String      @unique
  image_id        String
  image_name      String
  image_url       String

  transaction     Transaction   @relation(fields: [ref_id], references: [id], onDelete: Cascade)


  @@map("transaction_images")
}


