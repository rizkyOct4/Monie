generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  REGULAR
  PREMIUM
}
enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id        String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  public_id      String   @unique
  name      String
  email     String
  password  String?    @db.VarChar(255)

  user_type    UserType   @default(REGULAR)
  image_url String?
  created_at DateTime @default(now())

  accounts  Account[]
  transactions  Transaction[]

  @@map("users")
}

model Account {
  id        String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  balance   BigInt   @default(0)

  user_id    String   @db.Uuid
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)


  created_at DateTime @default(now())

  @@index([user_id])
  @@map("accounts")
}


model Transaction {
  ref_id          String   @db.Uuid     

  id              String    @unique
  name_transaction      String      @db.VarChar(255)
  created_at      DateTime @db.Date

  user      User     @relation(fields: [ref_id], references: [id], onDelete: Cascade)

  valuetransaction  ValueTransaction?
  
  @@map("transactions")
}

model ValueTransaction {
  ref_id      String    @unique
  information   String?     @db.VarChar(255)
  nominal       Int

  created_at      DateTime @db.Date
  updated_at      DateTime? @db.Date

  transaction     Transaction   @relation(fields: [ref_id], references: [id], onDelete: Cascade)

  table_ref    ValueTransactionImages[]      

  @@map("value_transaction")
}

model ValueTransactionImages {
  ref_id    String
  id          String      @unique
  image_id        String
  image_name      String
  image_url       String

  valuetransaction     ValueTransaction   @relation(fields: [ref_id], references: [ref_id], onDelete: Cascade)


  @@map("value_transaction_images")
}