generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Transaction {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  expense     Int      @default(0)
  income      Int      @default(0)

  created_at   DateTime @default(now())
}

model Salary {
  id        String   @id @default(cuid())
  amount    Int
  month     Int
  year      Int

  created_at DateTime @default(now())
}